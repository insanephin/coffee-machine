{
  "manifest_version": 3,
  "name": "커피머신",
  "version": "1.2.0",
  "description": "네이버 카페 UI/UX 개선 도구 모음집",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://cafe.naver.com/*", "https://m.cafe.naver.com/*", "https://section.cafe.naver.com/*"],
      "js": ["cafe.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "커피머신",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup/popup.html"
  }
}
